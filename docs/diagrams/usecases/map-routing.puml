@startuml map-routing-usecases
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam monochrome false
skinparam defaultFontName "Arial"

actor "Du khách (Web / Mobile)" as Tourist
actor "Quản trị viên (Admin)" as Admin
actor "Hệ thống GPS Thiết bị" as GPS
actor "OSRM Routing Engine" as OSRM

rectangle "Hệ thống Bản đồ & Dẫn đường Thực tế Quận 4" {
  usecase "UC-MAP-01: Khám phá Bản đồ Số\n& Viewport Động Quận 4" as UC1
  usecase "UC-MAP-02: Tìm kiếm & Lọc POI\nĐa ngôn ngữ & Danh mục" as UC2
  usecase "UC-MAP-03: Xem 3 Loại Khoảng Cách\n(Chim bay, Thực tế, Thời gian)" as UC3
  usecase "UC-MAP-04: Dẫn đường Từng bước\nTurn-by-turn (Đi bộ/Xe)" as UC4
  usecase "UC-MAP-05: Tái định tuyến Tự động\n(Off-track >35m, Cooldown 15s)" as UC5
  usecase "UC-MAP-06: Phát hiện Đến nơi\n& Kích hoạt Thuyết minh (<=15m)" as UC6
  usecase "UC-MAP-07: Chuyển tiếp Dẫn đường\nGoogle Maps Dự phòng" as UC7
  usecase "UC-MAP-08: Xem Toàn bộ Lộ trình Tour\n& Các chặng di chuyển (Legs)" as UC8
  usecase "UC-MAP-09: Quản lý Thứ tự POI Tour\n& Tự động Hủy Cache Tuyến đường" as UC9
}

Tourist --> UC1
Tourist --> UC2
Tourist --> UC3
Tourist --> UC4
Tourist --> UC7
Tourist --> UC8

GPS --> UC5 : Cung cấp tọa độ thực
GPS --> UC6 : Tọa độ đích đến

UC4 ..> UC5 : <<extend>>
UC4 ..> UC6 : <<include>>
UC4 ..> UC3 : <<include>>
UC8 ..> UC3 : <<include>>

UC4 --> OSRM : Tính toán đường đi
UC5 --> OSRM : Tính lại lộ trình
UC8 --> OSRM : Ghép nối các chặng

Admin --> UC9

@enduml
