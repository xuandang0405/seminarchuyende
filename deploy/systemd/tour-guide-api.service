[Unit]
Description=TourVoice Quận 4 - FastAPI Backend Service
After=network.target mongodb.service redis.service
Wants=mongodb.service redis.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/tour-guide/backend
EnvironmentFile=/opt/tour-guide/backend/.env

# Run uvicorn bound exclusively to host loopback (Nginx will proxy incoming public traffic)
ExecStart=/opt/tour-guide/backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 4 \
    --proxy-headers \
    --forwarded-allow-ips "*" \
    --no-access-log

Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=10s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
