# Copy to deploy/env/.env.production, chmod 600, and set values.
APP_ENV=production
DEBUG=false
ALLOW_MOCK_DATABASE=false
PROJECT_NAME="TourVoice Quận 4"
PUBLIC_WEB_URL=https://tour.example.com
FRONTEND_URL=https://tour.example.com
FRONTEND_CALLBACK_URL=https://tour.example.com/auth/callback
TRUSTED_HOSTS=tour.example.com,localhost,127.0.0.1
COOKIE_SECURE=true
DATABASE_NAME=tourvoice_district4

# Generate with openssl rand -hex 32 and openssl rand -base64 32.
SECRET_KEY=
OFFLINE_LICENSE_PRIVATE_KEY=

# Required for password recovery in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Optional Google login and AI Advisor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tour.example.com/api/v1/auth/google/callback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PAYMENT_MODE=live
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://tour.example.com/client/

# The deploy script creates the first admin separately.
SUPERADMIN_BOOTSTRAP_MODE=disabled
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
