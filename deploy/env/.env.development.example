JWT_SECRET="dev_secret_key_tourvoice_district_4_local"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

COOKIE_SECURE=false
