APP_ENV=development
DEBUG=true
PROJECT_NAME="TourVoice Quan 4 (Dev)"

HOST=127.0.0.1
PORT=8000

PUBLIC_WEB_URL="http://localhost:8000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000"
TRUSTED_HOSTS="*"
FORWARDED_ALLOW_IPS="*"

MONGODB_URL="mongodb://127.0.0.1:27017"
