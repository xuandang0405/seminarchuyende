# ==============================================================================
# HỆ THỐNG THUYẾT MINH DU LỊCH TỰ ĐỘNG ĐA NGÔN NGỮ QUẬN 4
# CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT CONFIGURATION TEMPLATE)
# ==============================================================================

# 1. Cấu hình Máy chủ FastAPI
PROJECT_NAME="Hệ thống Thuyết minh Du lịch Tự động Đa ngôn ngữ"
HOST="0.0.0.0"
PORT=8000
DEBUG=True
APP_ENV="development" # development | staging | production

# 2. Cơ sở Dữ liệu MongoDB
# Lưu ý: MongoDB phiên bản 4.0+ bắt buộc hỗ trợ Replica Set để thực thi Multi-document Transactions.
# Khi chạy local với Docker, sử dụng cấu hình replica set 1-node đi kèm dự án.
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="tour_guide"

# 3. Bảo mật & Xác thực (JWT / Session / Cryptography)
# Bắt buộc thay đổi SECRET_KEY bằng một chuỗi ngẫu nhiên mạnh (tối thiểu 32 bytes) khi triển khai thực tế.
SECRET_KEY="change_this_to_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Khóa bí mật dùng để ký số Giấy phép Thuyết minh Offline (7 ngày)
OFFLINE_SIGNING_SECRET="change_this_offline_signing_secret_for_license_verification"
OFFLINE_LICENSE_EXPIRE_DAYS=7

# 4. CORS Origins (Cho phép Web Client & Web Admin)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:8000"]

# 5. Cấu hình Cổng Thanh toán (Payment Gateway Configuration)
# Chế độ thanh toán:
# - "mock": Chế độ mô phỏng phục vụ phát triển cục bộ và chấm bài/demo môn học.
#          Giao diện và API sẽ hiển thị nhãn cảnh báo: "MÔ PHỎNG — KHÔNG CHUYỂN TIỀN THẬT".
# - "production" / "sandbox": Kích hoạt cổng thanh toán thật với VNPAY và payOS.
PAYMENT_MODE="mock"

# Cổng 1: VNPAY (Thanh toán Thẻ Quốc tế Visa / Mastercard qua Hosted Checkout)
# Tài liệu: https://sandbox.vnpayment.vn/apis/docs/thanh-toan-pay/pay.html
VNPAY_TMN_CODE="YOUR_VNPAY_TMN_CODE"
VNPAY_HASH_SECRET="YOUR_VNPAY_HASH_SECRET"
VNPAY_PAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:8000/client/index.html"
VNPAY_API_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"

# Cổng 2: payOS (Thanh toán Chuyển khoản Tự động VietQR)
# Tài liệu: https://payos.vn/docs/api/
PAYOS_CLIENT_ID="YOUR_PAYOS_CLIENT_ID"
PAYOS_API_KEY="YOUR_PAYOS_API_KEY"
PAYOS_CHECKSUM_KEY="YOUR_PAYOS_CHECKSUM_KEY"
PAYOS_ENDPOINT="https://api-merchant.payos.vn"
PAYOS_RETURN_URL="http://localhost:8000/client/index.html"
PAYOS_CANCEL_URL="http://localhost:8000/client/index.html"

# 6. Xác thực Google OAuth2 (Đăng nhập Google trên Web & React Native)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# 7. Giới hạn Tần suất & Chính sách Dùng thử (Rate Limit & Trial Policy)
TRIAL_POLICY_VERSION=1
TRIAL_MAX_FREE_PLAYS=1
RATE_LIMIT_GUEST_PER_MINUTE=20
RATE_LIMIT_RECONCILE_PER_MINUTE=10
