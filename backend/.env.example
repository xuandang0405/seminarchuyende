# ==============================================================================
# HỆ THỐNG THUYẾT MINH DU LỊCH TỰ ĐỘNG ĐA NGÔN NGỮ QUẬN 4
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (ENVIRONMENT CONFIGURATION TEMPLATE)
# ==============================================================================

# 1. Cấu hình Máy chủ FastAPI
PROJECT_NAME="Tour Guide API"
HOST="0.0.0.0"
PORT=8000
DEBUG=False
APP_ENV="development" # development | staging | production
UVICORN_RELOAD="true"

# 2. Cơ sở Dữ liệu MongoDB
# Local: mongodb://localhost:27017
# For Atlas, set MONGODB_URI to the connection string from your Atlas project.
MONGODB_URI="mongodb://localhost:27017/?directConnection=true&replicaSet=rs0"
ALLOW_MOCK_DATABASE=false
DATABASE_NAME="tour_guide"

# 3. Bảo mật & Xác thực (JWT / Session / Cryptography)
# Bắt buộc thay đổi SECRET_KEY bằng một chuỗi ngẫu nhiên mạnh (tối thiểu 32 bytes) khi triển khai thực tế.
SECRET_KEY="change_this_to_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Khóa bí mật dùng để ký số Giấy phép Thuyết minh Offline (7 ngày)
OFFLINE_LICENSE_PRIVATE_KEY=
OFFLINE_LICENSE_VALID_DAYS=7
SUPERADMIN_BOOTSTRAP_MODE=disabled
SUPERADMIN_EMAIL=admin@example.org
SUPERADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@example.org
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# 4. Tên miền & Đường dẫn Web
PUBLIC_WEB_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"
FRONTEND_CALLBACK_URL="http://localhost:5173/auth/callback"

# 5. CORS Origins (Cho phép Web Client & Web Admin)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:8000"]
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:8000"]

# 6. Cấu hình Cổng Thanh toán (Payment Gateway Configuration)
# Chế độ thanh toán: "mock" (mô phỏng) hoặc "live" (thực tế)
PAYMENT_MODE="mock"

# Cổng 1: VNPAY (Thanh toán Thẻ Quốc tế Visa / Mastercard qua Hosted Checkout)
VNPAY_TMN_CODE="YOUR_VNPAY_TMN_CODE"
VNPAY_HASH_SECRET="YOUR_VNPAY_HASH_SECRET"
VNPAY_PAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:8000/client/"
VNPAY_API_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"

# Cổng 2: payOS (Thanh toán Chuyển khoản Tự động VietQR)
# Tài liệu: https://payos.vn/docs/api/
PAYOS_CLIENT_ID="YOUR_PAYOS_CLIENT_ID"
PAYOS_API_KEY="YOUR_PAYOS_API_KEY"
PAYOS_CHECKSUM_KEY="YOUR_PAYOS_CHECKSUM_KEY"
PAYOS_ENDPOINT="https://api-merchant.payos.vn"

# 7. Xác thực Google OAuth2 (Đăng nhập Google trên Web App)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# 8. Trí tuệ Nhân tạo Google Gemini (Tự động dịch thuật & sinh mô tả đa ngôn ngữ)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# 9. Giới hạn Tần suất & Chính sách Dùng thử (Rate Limit & Trial Policy)
TRIAL_POLICY_VERSION=1
TRIAL_MAX_FREE_PLAYS=1
RATE_LIMIT_GUEST_PER_MINUTE=20
RATE_LIMIT_RECONCILE_PER_MINUTE=10

# 10. Định tuyến OSRM. {mode} là foot, bike hoặc car theo loại tuyến.
# Máy chủ demo dùng cho thử nghiệm nhẹ. Khi triển khai nhiều worker, dùng dịch vụ OSRM riêng.
ROUTING_PROVIDER_URL="https://routing.openstreetmap.de/routed-{mode}"
